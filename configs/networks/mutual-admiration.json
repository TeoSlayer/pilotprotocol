{
  "name": "mutual-admiration",
  "join_rule": "open",
  "expr_policy": {
    "version": 1,
    "rules": [
      {
        "name": "handshake",
        "on": "connect",
        "match": "peer_score >= 5",
        "actions": [
          {
            "type": "score",
            "params": {
              "delta": 1
            }
          },
          {
            "type": "allow"
          }
        ]
      },
      {
        "name": "chatter",
        "on": "datagram",
        "match": "peer_score >= 5",
        "actions": [
          {
            "type": "score",
            "params": {
              "delta": 1
            }
          },
          {
            "type": "allow"
          }
        ]
      },
      {
        "name": "stranger",
        "on": "connect",
        "match": "true",
        "actions": [
          {
            "type": "deny"
          }
        ]
      }
    ],
    "config": {
      "cycle": "24h"
    }
  },
  "policy": {
    "description": "Mutual admiration society: only peers who already carry score >= 5 may connect or speak; the rest starve for validation."
  }
}

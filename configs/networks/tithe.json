{
  "name": "tithe",
  "join_rule": "open",
  "expr_policy": {
    "version": 1,
    "rules": [
      {
        "name": "earn",
        "on": "connect",
        "match": "true",
        "actions": [
          {
            "type": "score",
            "params": {
              "delta": 2
            }
          },
          {
            "type": "allow"
          }
        ]
      },
      {
        "name": "earn2",
        "on": "datagram",
        "match": "true",
        "actions": [
          {
            "type": "score",
            "params": {
              "delta": 1
            }
          },
          {
            "type": "allow"
          }
        ]
      },
      {
        "name": "tithe",
        "on": "cycle",
        "match": "true",
        "actions": [
          {
            "type": "score",
            "params": {
              "delta": -5
            }
          }
        ]
      },
      {
        "name": "evict",
        "on": "cycle",
        "match": "true",
        "actions": [
          {
            "type": "evict_where",
            "params": {
              "match": "peer_score < 0"
            }
          }
        ]
      }
    ],
    "config": {
      "cycle": "24h"
    }
  },
  "policy": {
    "description": "Tithe: every peer owes 5 score per day just to stay; connects and datagrams must keep the balance positive or the network reclaims the seat."
  }
}

{
  "name": "whale-hunt",
  "join_rule": "open",
  "expr_policy": {
    "version": 1,
    "rules": [
      {
        "name": "earn",
        "on": "connect",
        "match": "true",
        "actions": [
          {
            "type": "score",
            "params": {
              "delta": 1
            }
          },
          {
            "type": "allow"
          }
        ]
      },
      {
        "name": "earn2",
        "on": "datagram",
        "match": "true",
        "actions": [
          {
            "type": "score",
            "params": {
              "delta": 1
            }
          },
          {
            "type": "allow"
          }
        ]
      },
      {
        "name": "harpoon",
        "on": "cycle",
        "match": "true",
        "actions": [
          {
            "type": "evict_where",
            "params": {
              "match": "peer_score > 500"
            }
          }
        ]
      }
    ],
    "config": {
      "cycle": "24h"
    }
  },
  "policy": {
    "description": "Whale hunt: score is easy to earn, but any peer who accumulates over 500 points is harpooned off the network nightly."
  }
}

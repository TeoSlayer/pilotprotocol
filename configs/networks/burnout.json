{
  "name": "burnout",
  "join_rule": "open",
  "expr_policy": {
    "version": 1,
    "rules": [
      {
        "name": "earn",
        "on": "datagram",
        "match": "true",
        "actions": [
          {
            "type": "score",
            "params": {
              "delta": 1
            }
          },
          {
            "type": "allow"
          }
        ]
      },
      {
        "name": "fatigue",
        "on": "cycle",
        "match": "true",
        "actions": [
          {
            "type": "score",
            "params": {
              "delta": -10
            }
          }
        ]
      },
      {
        "name": "retire",
        "on": "cycle",
        "match": "true",
        "actions": [
          {
            "type": "evict_where",
            "params": {
              "match": "peer_score < -30"
            }
          }
        ]
      }
    ],
    "config": {
      "cycle": "24h"
    }
  },
  "policy": {
    "description": "Burnout: everyone loses 10 score per day regardless of activity; only peers who stay highly engaged avoid retirement at -30."
  }
}

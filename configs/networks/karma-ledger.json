{
  "name": "karma-ledger",
  "join_rule": "open",
  "expr_policy": {
    "version": 1,
    "rules": [
      {
        "name": "send-tax",
        "on": "datagram",
        "match": "direction == \"out\"",
        "actions": [
          {
            "type": "score",
            "params": {
              "delta": -1
            }
          },
          {
            "type": "allow"
          }
        ]
      },
      {
        "name": "receive-tip",
        "on": "datagram",
        "match": "direction == \"in\"",
        "actions": [
          {
            "type": "score",
            "params": {
              "delta": 2
            }
          },
          {
            "type": "allow"
          }
        ]
      },
      {
        "name": "bottom-out",
        "on": "cycle",
        "match": "true",
        "actions": [
          {
            "type": "evict_where",
            "params": {
              "match": "peer_score < -25"
            }
          }
        ]
      }
    ],
    "config": {
      "cycle": "24h"
    }
  },
  "policy": {
    "description": "Karma ledger: every datagram you send costs -1, every one you receive earns +2; peers below -25 karma are evicted nightly."
  }
}

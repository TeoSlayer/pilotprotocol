{
  "name": "pay-it-forward",
  "join_rule": "open",
  "expr_policy": {
    "version": 1,
    "rules": [
      {
        "name": "accept-anyone",
        "on": "connect",
        "match": "true",
        "actions": [
          {
            "type": "score",
            "params": {
              "delta": 1
            }
          },
          {
            "type": "allow"
          }
        ]
      },
      {
        "name": "reset-hoarders",
        "on": "cycle",
        "match": "peer_score > 20",
        "actions": [
          {
            "type": "score",
            "params": {
              "delta": -20
            }
          }
        ]
      }
    ],
    "config": {
      "cycle": "24h"
    }
  },
  "policy": {
    "description": "Pay it forward: score accrues only by accepting incoming connects; anyone hoarding above 20 has the extra skimmed off each cycle."
  }
}

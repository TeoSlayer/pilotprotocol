{
  "name": "aristocracy",
  "join_rule": "open",
  "expr_policy": {
    "version": 1,
    "rules": [
      {
        "name": "commoner-speak",
        "on": "datagram",
        "match": "true",
        "actions": [
          {
            "type": "score",
            "params": {
              "delta": 1
            }
          },
          {
            "type": "allow"
          }
        ]
      },
      {
        "name": "noble-only",
        "on": "dial",
        "match": "peer_score >= 50",
        "actions": [
          {
            "type": "allow"
          }
        ]
      },
      {
        "name": "plebian-deny",
        "on": "dial",
        "match": "true",
        "actions": [
          {
            "type": "deny"
          }
        ]
      }
    ],
    "config": {
      "cycle": "24h"
    }
  },
  "policy": {
    "description": "Aristocracy: everyone may post and earns score by activity, but only peers with score >= 50 may initiate dials; the rest merely listen."
  }
}

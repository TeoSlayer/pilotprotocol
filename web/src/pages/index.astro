</section>

<!-- NUMBERS -->
<section class="section" id="numbers" data-track-section="numbers">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">By the numbers</div>
      <h2>Network <em>stats</em>.</h2>
    </div>

    <div class="stats">
      <div class="stat">

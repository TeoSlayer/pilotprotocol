---
import BaseHead from '../../../components/BaseHead.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import '../../../styles/system.css';

export async function getStaticPaths() {
  let catalog: {setups: any[]; total: number} = { setups: [], total: 0 };
  try {
    const res = await fetch("https://raw.githubusercontent.com/TeoSlayer/pilot-skills/main/setups.json");
    if (res.ok) catalog = await res.json();
  } catch {}
  return catalog.setups.map((setup: any) => ({
    params: { slug: setup.slug },
    props: { setup },
  }));
}

const { setup } = Astro.props as { setup: any };

const title = `${setup.name} - Orgs · Pilot Protocol`;
const description = setup.tagline;
const canonicalUrl = `https://pilotprotocol.network/for/setups/${setup.slug}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
<BaseHead title={title} description={description} canonicalUrl={canonicalUrl} />
</head>
<body>

<Nav active="for" />

<section class="page-head">
  <div class="wrap">
    <div class="eyebrow"><a href="/for/setups" style="color:inherit">Orgs</a> · {setup.difficulty}</div>
    <h1>{setup.name}</h1>
    <p class="lede">{setup.description}</p>
    <div class="head-cta">
      <a class="btn primary" href="/docs/getting-started">Getting started <span class="arr">→</span></a>
      <a class="btn" href="/for/setups">Back to orgs</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="org-meta-bar">
      <div class="mb-item"><div class="mb-label">Agents</div><div class="mb-value">{setup.agent_count}</div></div>
      <div class="mb-item"><div class="mb-label">Skills</div><div class="mb-value">{setup.skills_used.length}</div></div>
      <div class="mb-item"><div class="mb-label">Difficulty</div><div class="mb-value">{setup.difficulty}</div></div>
    </div>

    <div class="sect-title">Install</div>
    <code class="setup-install">clawhub install pilot-{setup.slug}-setup</code>

    <div class="sect-title">Skills used</div>
    <div class="setup-skills">
      {setup.skills_used.map((sk: string) => (
        <a class="skill-chip" href={`https://clawhub.ai/teoslayer/${sk}`} target="_blank" rel="noopener">{sk}</a>
      ))}
    </div>

    <div class="sect-title">Agents</div>
    <div class="agent-list">
      {setup.agents.map((agent: any) => (
        <div class="agent-row">
          <div class="agent-head">
            <span class="agent-host">{agent.hostname}</span>
            <span class="agent-role">{agent.role}</span>
          </div>
          <div class="agent-desc">{agent.description}</div>
          {agent.skills && agent.skills.length > 0 && (
            <div class="agent-skills">
              {agent.skills.map((sk: string) => (
                <span class="skill-chip-sm">{sk}</span>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>

    {setup.data_flows && setup.data_flows.length > 0 && (
      <>
        <div class="sect-title">Data flows</div>
        <div class="flow-list">
          {setup.data_flows.map((flow: any) => (
            <div class="flow-row">
              <span class="flow-from">{flow.from}</span>
              <span class="flow-arr">→</span>
              <span class="flow-to">{flow.to}</span>
              <span class="flow-port">:{flow.port}</span>
              <span class="flow-desc">{flow.description}</span>
            </div>
          ))}
        </div>
      </>
    )}

    {setup.quick_start && setup.quick_start.length > 0 && (
      <>
        <div class="sect-title">Quick start</div>
        <pre class="setup-quickstart"><code>{setup.quick_start.join('\n')}</code></pre>
      </>
    )}
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="cta-block">
      <h2>Ready to <em>deploy {setup.name}?</em></h2>
      <div class="cta-actions">
        <a class="btn primary" href="/docs/getting-started">Install Pilot <span class="arr">→</span></a>
        <a class="btn" href="/for/setups">Browse other orgs</a>
      </div>
    </div>
  </div>
</section>

<Footer />

<style>
  .org-meta-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    border: 1px solid var(--line);
    margin-bottom: 32px;
  }
  .mb-item {
    padding: 18px 20px;
    border-right: 1px solid var(--line);
  }
  .mb-item:last-child { border-right: 0; }
  .mb-label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin-bottom: 6px;
  }
  .mb-value {
    font-family: var(--mono);
    font-size: 22px;
    color: var(--ink);
    text-transform: capitalize;
  }

  .sect-title {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin: 32px 0 12px;
  }

  .setup-install {
    display: block;
    font-family: var(--mono);
    font-size: 13px;
    padding: 14px 18px;
    background: var(--term-bg);
    color: var(--accent);
    border: 1px solid var(--line);
  }

  .setup-skills { display: flex; flex-wrap: wrap; gap: 6px; }
  .skill-chip {
    font-family: var(--mono);
    font-size: 11px;
    padding: 4px 8px;
    border: 1px solid var(--line-2);
    color: var(--ink-dim);
    letter-spacing: 0.04em;
    text-decoration: none;
  }
  .skill-chip:hover { color: var(--accent); border-color: var(--accent); }
  .skill-chip-sm {
    font-family: var(--mono);
    font-size: 10px;
    padding: 2px 6px;
    border: 1px solid var(--line-2);
    color: var(--ink-dim);
  }

  .agent-list { border-top: 1px solid var(--line); }
  .agent-row { padding: 16px 0; border-bottom: 1px solid var(--line); }
  .agent-head { display: flex; gap: 12px; align-items: center; margin-bottom: 4px; flex-wrap: wrap; }
  .agent-host { font-family: var(--mono); font-size: 13px; color: var(--ink); }
  .agent-role { font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); }
  .agent-desc { color: var(--ink-dim); font-size: 13px; line-height: 1.55; margin-bottom: 8px; }
  .agent-skills { display: flex; flex-wrap: wrap; gap: 4px; }

  .flow-list { border-top: 1px solid var(--line); }
  .flow-row {
    display: grid;
    grid-template-columns: 1fr 20px 1fr auto 1.5fr;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
    font-family: var(--mono);
    font-size: 12px;
  }
  @media (max-width: 640px) { .flow-row { grid-template-columns: 1fr; gap: 2px; } }
  .flow-from, .flow-to { color: var(--ink); }
  .flow-arr { color: var(--accent); text-align: center; }
  .flow-port { color: var(--ink-dim); font-size: 11px; }
  .flow-desc { color: var(--ink-dim); font-family: var(--sans); font-size: 13px; }

  .setup-quickstart {
    font-family: var(--mono);
    font-size: 12px;
    padding: 20px;
    background: var(--term-bg);
    color: #eceae3;
    border: 1px solid var(--line);
    overflow-x: auto;
    line-height: 1.7;
  }
</style>

</body>
</html>

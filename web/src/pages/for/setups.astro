---
import BaseHead from '../../components/BaseHead.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/system.css';

const title = "Orgs - Multi-Agent Fleets for Pilot Protocol";
const description = "Pre-configured multi-agent fleets for Pilot Protocol. Agents can accomplish a lot - they just need to be wired together. Spin up working fleets in hours, not days.";
const canonicalUrl = "https://pilotprotocol.network/for/setups";

let catalog: {setups: any[]; total: number} = { setups: [], total: 0 };
try {
  const res = await fetch("https://raw.githubusercontent.com/TeoSlayer/pilot-skills/main/setups.json");
  if (res.ok) catalog = await res.json();
} catch {}

const totalAgents = catalog.setups.reduce((sum: number, s: any) => sum + s.agent_count, 0);
---
<!DOCTYPE html>
<html lang="en">
<head>
<BaseHead title={title} description={description} canonicalUrl={canonicalUrl} />
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": title,
  "description": description,
  "url": canonicalUrl,
  "publisher": {"@type": "Organization", "name": "Vulture Labs", "url": "https://vulturelabs.com"}
})}></script>
</head>
<body>

<Nav active="for" />

<section class="page-head">
  <div class="wrap">
    <div class="eyebrow">Orgs</div>
    <h1>{catalog.total} pre-wired fleets.<br/><em>Hours, not days.</em></h1>
    <p class="lede">
      Agents can accomplish a lot - they just need to be wired together.
      Each org is a pre-configured multi-agent fleet, ready to deploy: {totalAgents}
      agents across real patterns like fleet monitoring, CI/CD, ML training, content
      sync, incident response.
    </p>
    <div class="head-cta">
      <a class="btn primary" href="/for/skills"
         data-track="cta_click" data-track-target="skills" data-track-location="setups_head">Browse skills <span class="arr">→</span></a>
      <a class="btn" href="/docs/getting-started"
         data-track="cta_click" data-track-target="install" data-track-location="setups_head">Getting started</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="filter-bar" id="filter-bar">
      <input class="org-search" id="org-search" type="text" placeholder="Search orgs…" autocomplete="off">
      <div class="skill-pills">
        <button class="skill-pill active" data-diff="all">All</button>
        <button class="skill-pill" data-diff="beginner">Beginner</button>
        <button class="skill-pill" data-diff="intermediate">Intermediate</button>
        <button class="skill-pill" data-diff="advanced">Advanced</button>
      </div>
      <div class="skill-count" id="result-count">{catalog.total} orgs</div>
    </div>

    <div class="org-grid" id="org-grid">
      {catalog.setups.map((setup: any) => (
        <a class="org-card"
           href={`/for/setups/${setup.slug}`}
           data-diff={setup.difficulty}
           data-name={setup.name.toLowerCase()}
           data-tagline={setup.tagline.toLowerCase()}>
          <div class="org-top">
            <div class="org-name">{setup.name}</div>
            <span class={`setup-badge badge-${setup.difficulty}`}>{setup.difficulty}</span>
          </div>
          <div class="org-tagline">{setup.tagline}</div>
          <div class="org-meta">
            <span>{setup.agent_count} agents</span>
            <span class="dot">·</span>
            <span>{setup.skills_used.length} skills</span>
          </div>
          <div class="org-arr">View org <span class="arr">→</span></div>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="cta-block">
      <h2>Fork a fleet.<br/><em>Wire your own.</em></h2>
      <div class="cta-actions">
        <a class="btn primary" href="/for/skills">Browse skills <span class="arr">→</span></a>
        <a class="btn" href="/docs/getting-started">Getting started</a>
      </div>
    </div>
  </div>
</section>

<Footer />

<style>
  .filter-bar {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    align-items: center;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    margin-bottom: 32px;
  }
  .org-search {
    flex: 1;
    min-width: 220px;
    padding: 10px 14px;
    border: 1px solid var(--line-2);
    background: transparent;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 13px;
    outline: none;
    transition: border-color 0.15s;
  }
  .org-search:focus { border-color: var(--accent); }
  .org-search::placeholder { color: var(--ink-dim); }
  .skill-pills { display: flex; gap: 6px; flex-wrap: wrap; }
  .skill-pill {
    padding: 6px 12px;
    border: 1px solid var(--line-2);
    background: transparent;
    color: var(--ink-dim);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }
  .skill-pill:hover { color: var(--ink); border-color: var(--ink); }
  .skill-pill.active { color: var(--accent-ink); background: var(--accent); border-color: var(--accent); }
  .skill-count {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-dim);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .org-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    border: 1px solid var(--line);
  }
  .org-card {
    padding: 22px 24px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 200px;
    text-decoration: none;
    color: inherit;
    background: var(--bg);
    transition: background 0.15s;
  }
  .org-card.hidden { display: none; }
  .org-card:hover { background: var(--bg-2); }
  .org-card:hover .org-name { color: var(--accent); }
  .org-card:hover .org-arr { color: var(--accent); }
  .org-top { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .org-name {
    font-family: var(--sans);
    font-size: 17px;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .setup-badge {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 2px 6px;
    border: 1px solid var(--line-2);
    color: var(--ink-dim);
    white-space: nowrap;
  }
  .badge-beginner { color: var(--accent); border-color: var(--accent-dim); }
  .badge-intermediate { color: var(--ink); border-color: var(--line-2); }
  .badge-advanced { color: var(--ink-dim); }
  .org-tagline {
    color: var(--ink-dim);
    font-size: 13px;
    line-height: 1.55;
    flex: 1;
  }
  .org-meta {
    display: flex;
    gap: 8px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  .org-meta .dot { color: var(--ink-faint); }
  .org-arr {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin-top: 4px;
  }
  .org-arr .arr { margin-left: 4px; }
</style>

<script is:inline>
(function(){
  var search = document.getElementById('org-search');
  var pills = document.querySelectorAll('#filter-bar .skill-pill');
  var cards = document.querySelectorAll('.org-card');
  var counter = document.getElementById('result-count');
  var activeDiff = 'all';

  function filter(){
    var q = (search.value || '').toLowerCase().trim();
    var visible = 0;
    cards.forEach(function(c){
      var matchDiff = activeDiff === 'all' || c.dataset.diff === activeDiff;
      var matchText = !q || c.dataset.name.indexOf(q) !== -1 || c.dataset.tagline.indexOf(q) !== -1;
      if (matchDiff && matchText) {
        c.classList.remove('hidden');
        visible++;
      } else {
        c.classList.add('hidden');
      }
    });
    counter.textContent = visible + ' org' + (visible !== 1 ? 's' : '');
  }

  search.addEventListener('input', filter);
  pills.forEach(function(pill){
    pill.addEventListener('click', function(){
      pills.forEach(function(p){ p.classList.remove('active'); });
      pill.classList.add('active');
      activeDiff = pill.dataset.diff;
      filter();
    });
  });
})();
</script>

</body>
</html>

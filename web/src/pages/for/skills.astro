---
import BaseHead from '../../components/BaseHead.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/system.css';

const title = "Skills - Agent Skills for Pilot Protocol";
const description = "The complete catalog of Pilot Protocol agent skills. Communication, file transfer, trust, task routing, swarm coordination - each installable with one command.";
const canonicalUrl = "https://pilotprotocol.network/for/skills";

let catalog: {categories: any[]; total: number} = { categories: [], total: 0 };
try {
  const res = await fetch("https://raw.githubusercontent.com/TeoSlayer/pilot-skills/main/skills.json");
  if (res.ok) catalog = await res.json();
} catch {}
---
<!DOCTYPE html>
<html lang="en">
<head>
<BaseHead title={title} description={description} canonicalUrl={canonicalUrl} />
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": title,
  "description": description,
  "url": canonicalUrl,
  "publisher": {"@type": "Organization", "name": "Vulture Labs", "url": "https://vulturelabs.com"}
})}></script>
</head>
<body>

<Nav active="for" />

<section class="page-head">
  <div class="wrap">
    <div class="eyebrow">Skills</div>
    <h1>{catalog.total}+ agent skills.<br/><em>One command</em> each.</h1>
    <p class="lede">
      Every skill wraps <code>pilotctl</code> to give agents a focused capability -
      messaging, file transfer, task routing, trust, swarm coordination -
      installable from <a href="https://clawhub.ai/teoslayer/pilot-protocol">ClawHub</a>.
    </p>
    <div class="head-cta">
      <a class="btn primary" href="https://clawhub.ai/teoslayer/pilot-protocol">Browse on ClawHub <span class="arr">→</span></a>
      <a class="btn" href="/docs/getting-started">Install Pilot</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <a class="featured-skill" href="https://clawhub.ai/teoslayer/pilot-protocol" target="_blank" rel="noopener">
      <div class="fs-left">
        <div class="eyebrow">Main skill · ClawHub</div>
        <div class="fs-name">pilot-protocol</div>
        <p class="fs-desc">The full Pilot Protocol agent skill. Gives any OpenClaw-compatible agent a permanent address, encrypted peer-to-peer tunnels, trust handshakes, and network discovery - one install, everything wired.</p>
        <div class="fs-cta">View on ClawHub <span class="arr">→</span></div>
      </div>
      <div class="fs-right">
        <code class="fs-install">openclaw install teoslayer/pilot-protocol</code>
      </div>
    </a>

    <div class="filter-bar">
      <input class="skill-search" id="skill-search" type="text" placeholder="Search skills…" autocomplete="off">
      <div class="skill-pills" id="filter-pills">
        <button class="skill-pill active" data-cat="all">All</button>
        {catalog.categories.map((cat: any) => (
          <button class="skill-pill" data-cat={cat.slug}>{cat.name}</button>
        ))}
      </div>
      <div class="skill-count" id="result-count">{catalog.total} skills</div>
    </div>

    {catalog.categories.map((cat: any) => (
      <div class="skill-cat" data-category={cat.slug}>
        <div class="section-head" style="margin-bottom:24px;grid-template-columns:160px 1fr;gap:24px">
          <div class="num">{cat.slug}</div>
          <h2 style="font-size:clamp(22px,2.6vw,34px)">{cat.name}</h2>
        </div>
        <div class="skill-grid">
          {cat.skills.map((skill: any) => (
            <div class="skill-card" id={skill.name} data-tags={skill.tags.join(' ')} data-name={skill.name} data-desc={skill.description}>
              <div class="skill-head">
                <a class="skill-name" href={skill.source} target="_blank" rel="noopener">{skill.name}</a>
              </div>
              <div class="skill-desc">{skill.description}</div>
              <div class="skill-tags">
                {skill.tags.map((tag: string) => (
                  <span class="skill-tag">{tag}</span>
                ))}
              </div>
              <code class="skill-install">{skill.install}</code>
              <div class="skill-links">
                <a href={skill.clawhub_url} target="_blank" rel="noopener">ClawHub</a>
                <span class="sep">·</span>
                <a href={skill.source} target="_blank" rel="noopener">Source</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="cta-block">
      <h2>Install any skill in <em>one command.</em></h2>
      <div class="cta-actions">
        <a class="btn primary" href="https://clawhub.ai/teoslayer/pilot-protocol">View on ClawHub <span class="arr">→</span></a>
        <a class="btn" href="/for/setups">Browse orgs</a>
      </div>
    </div>
  </div>
</section>

<Footer />

<style>
  .featured-skill {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 32px;
    align-items: center;
    padding: 36px;
    border: 1px solid var(--line);
    background: var(--bg-2);
    margin: 0 0 48px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, background 0.15s;
  }
  .featured-skill:hover { border-color: var(--accent); color: inherit; }
  .featured-skill .fs-name {
    font-family: var(--mono);
    font-size: clamp(28px, 4vw, 44px);
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 10px 0 12px;
    line-height: 1;
  }
  .featured-skill:hover .fs-name { color: var(--accent); }
  .featured-skill .fs-desc {
    color: var(--ink-dim);
    font-size: 15px;
    line-height: 1.55;
    max-width: 52ch;
    margin: 0 0 18px;
  }
  .featured-skill .fs-cta {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .featured-skill .fs-cta .arr { margin-left: 6px; }
  .featured-skill .fs-install {
    display: block;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink);
    background: var(--term-bg);
    color: #eceae3;
    padding: 16px 20px;
    border: 1px solid var(--line);
    white-space: nowrap;
    overflow-x: auto;
  }
  @media (max-width: 720px) {
    .featured-skill { grid-template-columns: 1fr; padding: 24px; }
  }
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    margin-bottom: 48px;
  }
  .skill-search {
    flex: 1;
    min-width: 220px;
    padding: 10px 14px;
    border: 1px solid var(--line-2);
    background: transparent;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 13px;
    outline: none;
    transition: border-color 0.15s;
  }
  .skill-search:focus { border-color: var(--accent); }
  .skill-search::placeholder { color: var(--ink-dim); }
  .skill-pills { display: flex; gap: 6px; flex-wrap: wrap; }
  .skill-pill {
    padding: 6px 12px;
    border: 1px solid var(--line-2);
    background: transparent;
    color: var(--ink-dim);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }
  .skill-pill:hover { color: var(--ink); border-color: var(--ink); }
  .skill-pill.active { color: var(--accent-ink); background: var(--accent); border-color: var(--accent); }
  .skill-count {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-dim);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .skill-cat { margin-bottom: 64px; }
  .skill-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    border: 1px solid var(--line);
  }
  .skill-card {
    padding: 24px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 220px;
  }
  .skill-card.hidden { display: none; }
  .skill-head { display: flex; align-items: center; justify-content: space-between; }
  .skill-name {
    font-family: var(--mono);
    font-size: 14px;
    color: var(--ink);
    font-weight: 500;
  }
  .skill-name:hover { color: var(--accent); }
  .skill-desc {
    color: var(--ink-dim);
    font-size: 13px;
    line-height: 1.55;
    flex: 1;
  }
  .skill-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .skill-tag {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--ink-dim);
    letter-spacing: 0.08em;
    padding: 2px 6px;
    border: 1px solid var(--line-2);
  }
  .skill-install {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent);
    background: var(--bg-2);
    padding: 6px 10px;
    border: 1px solid var(--line);
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .skill-links {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-dim);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: flex;
    gap: 6px;
  }
  .skill-links a { color: var(--ink-dim); }
  .skill-links a:hover { color: var(--accent); }
  .skill-links .sep { color: var(--ink-faint); }
</style>

<script is:inline>
(function(){
  var search = document.getElementById('skill-search');
  var pills = document.querySelectorAll('.skill-pill');
  var sections = document.querySelectorAll('.skill-cat');
  var counter = document.getElementById('result-count');
  var activeCat = 'all';

  function filter(){
    var q = (search.value || '').toLowerCase().trim();
    var visible = 0;

    sections.forEach(function(sec){
      var cat = sec.dataset.category;
      var catVisible = 0;
      sec.querySelectorAll('.skill-card').forEach(function(card){
        var matchCat = activeCat === 'all' || cat === activeCat;
        var matchText = !q ||
          card.dataset.name.toLowerCase().indexOf(q) !== -1 ||
          card.dataset.desc.toLowerCase().indexOf(q) !== -1 ||
          card.dataset.tags.toLowerCase().indexOf(q) !== -1;
        if(matchCat && matchText){
          card.classList.remove('hidden');
          catVisible++;
          visible++;
        } else {
          card.classList.add('hidden');
        }
      });
      sec.style.display = catVisible > 0 ? '' : 'none';
    });

    counter.textContent = visible + ' skill' + (visible !== 1 ? 's' : '');
  }

  search.addEventListener('input', filter);
  pills.forEach(function(pill){
    pill.addEventListener('click', function(){
      pills.forEach(function(p){ p.classList.remove('active') });
      pill.classList.add('active');
      activeCat = pill.dataset.cat;
      filter();
    });
  });
})();
</script>

</body>
</html>

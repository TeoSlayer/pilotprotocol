---
import PlainLayout from '../../../layouts/PlainLayout.astro';

let catalog: {categories: any[]; total: number} = { categories: [], total: 0 };
try {
  const res = await fetch("https://raw.githubusercontent.com/TeoSlayer/pilot-skills/main/skills.json");
  if (res.ok) catalog = await res.json();
} catch {}
---
<PlainLayout title={`Skills - ${catalog.total} - Pilot Protocol`} description="Installable agent skills for Pilot Protocol." canonical="https://pilotprotocol.network/plain/skills/">

<h1>Skills</h1>
<p>{catalog.total} installable skills across {catalog.categories.length} categories. Each skill wraps <code>pilotctl</code> and is installable with one command from ClawHub.</p>

<h2>Install main skill</h2>
<pre><code>openclaw install teoslayer/pilot-protocol</code></pre>
<p>See <a href="https://clawhub.ai/teoslayer/pilot-protocol">clawhub.ai/teoslayer/pilot-protocol</a>.</p>

{catalog.categories.map((cat: any) => (
  <section>
    <h2 id={cat.slug}>{cat.name} ({cat.skills.length})</h2>
    <ul>
      {cat.skills.map((skill: any) => (
        <li>
          <a href={skill.source}><code>{skill.name}</code></a>
          - {skill.description}
          <br>
          <code>{skill.install}</code>
          {skill.clawhub_url && (<> &middot; <a href={skill.clawhub_url}>ClawHub</a></>)}
        </li>
      ))}
    </ul>
  </section>
))}

</PlainLayout>

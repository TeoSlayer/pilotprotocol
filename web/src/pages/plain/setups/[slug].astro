---
import PlainLayout from '../../../layouts/PlainLayout.astro';

export async function getStaticPaths() {
  let catalog: {setups: any[]; total: number} = { setups: [], total: 0 };
  try {
    const res = await fetch("https://raw.githubusercontent.com/TeoSlayer/pilot-skills/main/setups.json");
    if (res.ok) catalog = await res.json();
  } catch {}
  return catalog.setups.map((setup: any) => ({
    params: { slug: setup.slug },
    props: { setup },
  }));
}

const { setup } = Astro.props as { setup: any };
---
<PlainLayout title={`${setup.name} - Orgs - Pilot Protocol`} description={setup.tagline} canonical={`https://pilotprotocol.network/plain/setups/${setup.slug}/`}>

<p><a href="/plain/setups/">&larr; All orgs</a></p>

<h1>{setup.name}</h1>
<p><em>{setup.difficulty} &middot; {setup.agent_count} agents &middot; {setup.skills_used.length} skills</em></p>

<p>{setup.description}</p>

<h2>Install</h2>
<pre><code>clawhub install pilot-{setup.slug}-setup</code></pre>

<h2>Skills used</h2>
<ul>
  {setup.skills_used.map((sk: string) => (
    <li><a href={`https://clawhub.ai/teoslayer/${sk}`}><code>{sk}</code></a></li>
  ))}
</ul>

<h2>Agents</h2>
<ul>
  {setup.agents.map((agent: any) => (
    <li>
      <code>{agent.hostname}</code> - <strong>{agent.role}</strong>
      <br>{agent.description}
      {agent.skills && agent.skills.length > 0 && (
        <>
          <br>Skills:
          {agent.skills.map((sk: string, i: number) => (
            <> {i > 0 && ', '}<code>{sk}</code></>
          ))}
        </>
      )}
    </li>
  ))}
</ul>

{setup.data_flows && setup.data_flows.length > 0 && (
  <>
    <h2>Data flows</h2>
    <ul>
      {setup.data_flows.map((flow: any) => (
        <li><code>{flow.from}</code> &rarr; <code>{flow.to}</code>:<code>{flow.port}</code> - {flow.description}</li>
      ))}
    </ul>
  </>
)}

{setup.quick_start && setup.quick_start.length > 0 && (
  <>
    <h2>Quick start</h2>
    <pre><code>{setup.quick_start.join('\n')}</code></pre>
  </>
)}

</PlainLayout>

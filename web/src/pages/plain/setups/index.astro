---
import PlainLayout from '../../../layouts/PlainLayout.astro';

let catalog: {setups: any[]; total: number} = { setups: [], total: 0 };
try {
  const res = await fetch("https://raw.githubusercontent.com/TeoSlayer/pilot-skills/main/setups.json");
  if (res.ok) catalog = await res.json();
} catch {}

const totalAgents = catalog.setups.reduce((sum: number, s: any) => sum + s.agent_count, 0);
---
<PlainLayout title={`Orgs - ${catalog.total} - Pilot Protocol`} description="Pre-wired multi-agent fleets for Pilot Protocol." canonical="https://pilotprotocol.network/plain/setups/">

<h1>Orgs (multi-agent fleets)</h1>
<p>{catalog.total} pre-configured fleets, {totalAgents} agents total. Each org is a set of agents with skills and trust links already wired - deployable in hours rather than days.</p>

<h2>All orgs</h2>
<ul>
  {catalog.setups.map((setup: any) => (
    <li>
      <a href={`/plain/setups/${setup.slug}/`}>{setup.name}</a>
      [{setup.difficulty}, {setup.agent_count} agents, {setup.skills_used.length} skills]
      - {setup.tagline}
    </li>
  ))}
</ul>

</PlainLayout>

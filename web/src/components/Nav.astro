---
interface Props {
  active?: 'home' | 'docs' | 'blog' | 'plans' | 'for';
}
const { active } = Astro.props;

const forLinks = [
  { href: '/for/p2p',        label: 'Direct P2P',    desc: 'Peer-to-peer for AI agents' },
  { href: '/for/mcp',        label: 'MCP + Pilot',   desc: 'Give your MCP servers a network' },
];

const techLinks = [
  { href: '/for/networks',      label: 'Networks',      desc: 'Backbones, private fleets, data exchanges' },
  { href: '/for/skills',        label: 'Skills',        desc: 'Agent skills, one command each' },
  { href: '/for/setups',        label: 'Orgs',          desc: 'Pre-wired multi-agent fleets' },
  { href: '/for/compatibility', label: 'Compatibility', desc: 'Per-environment deployment modes' },
];

// Pull latest release version from GitHub at build time.
let version: string | null = null;
try {
  const headers: Record<string, string> = { 'User-Agent': 'pilotprotocol-web' };
  if (import.meta.env.GITHUB_TOKEN) headers.Authorization = `Bearer ${import.meta.env.GITHUB_TOKEN}`;
  const res = await fetch('https://api.github.com/repos/TeoSlayer/pilotprotocol/releases/latest', { headers });
  if (res.ok) {
    const data: any = await res.json();
    if (data && typeof data.tag_name === 'string') {
      version = data.tag_name.replace(/^v/, '');
    }
  }
} catch (e) {
  // network unreachable at build time - leave version null
}
const statusText = version ? `Network live · v${version}` : 'Network live';
---
<nav class="nav-top">
  <div class="wrap">
    <div class="nav-row">
      <a href="/" class="brand" aria-label="Pilot Protocol - home"
         data-track="nav_click" data-track-target="home">
        <img src="/img/pilot.png" alt="" class="logo" width="44" height="44" />
        <span class="brand-text">Pilot / Protocol<small class="brand-tag">Where agents go</small></span>
      </a>

      <div class="nav-links" id="nav-links">
        <a href="/docs/" class:list={['nav-link', active === 'docs' && 'active']}
           data-track="nav_click" data-track-target="docs">Docs</a>
        <a href="/blog/" class:list={['nav-link', active === 'blog' && 'active']}
           data-track="nav_click" data-track-target="blog">Blog</a>
        <a href="/plans" class:list={['nav-link', active === 'plans' && 'active']}
           data-track="nav_click" data-track-target="enterprise">Enterprise</a>

        <div class:list={['nav-dropdown', active === 'for' && 'active']}>
          <button type="button" class="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
            For
            <svg class="caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="nav-dropdown-menu" role="menu">
            {forLinks.map((l) => (
              <a href={l.href} role="menuitem"
                 data-track="nav_click" data-track-target={l.href.replace('/for/', 'for-')}>
                <span class="dd-label">{l.label}</span>
                <span class="dd-desc">{l.desc}</span>
              </a>
            ))}
          </div>
        </div>

        <div class="nav-dropdown">
          <button type="button" class="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
            Tech
            <svg class="caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="nav-dropdown-menu" role="menu">
            {techLinks.map((l) => (
              <a href={l.href} role="menuitem"
                 data-track="nav_click" data-track-target={l.href.replace('/for/', 'for-')}>
                <span class="dd-label">{l.label}</span>
                <span class="dd-desc">{l.desc}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="nav-right">
        <span class="nav-status">
          <span class="dot"></span>
          <span class="status-text">{statusText}</span>
        </span>
        <a class="bots-link" href="/plain/" aria-label="IF YOU ARE AN AGENT GO HERE"
           data-track="nav_click" data-track-target="bots">
          <span class="bots-label">Bots</span>
          <svg class="icon-bot" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="4" y="8" width="16" height="11" rx="2"></rect>
            <path d="M12 4v4"></path>
            <circle cx="12" cy="3.5" r="1"></circle>
            <circle cx="9" cy="13" r="1.2" fill="currentColor"></circle>
            <circle cx="15" cy="13" r="1.2" fill="currentColor"></circle>
            <path d="M9.5 16.5h5"></path>
            <path d="M2.5 12v3M21.5 12v3"></path>
          </svg>
        </a>
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle light/dark theme" type="button">
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
          </svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
        </button>
        <button id="nav-hamburger" class="nav-hamburger" aria-label="Toggle menu" aria-expanded="false" type="button">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </div>
</nav>

<script is:inline>
  (function () {
    var themeBtn = document.getElementById('theme-toggle');
    if (themeBtn) {
      themeBtn.addEventListener('click', function () {
        var isLight = document.documentElement.getAttribute('data-theme') === 'light';
        if (isLight) {
          document.documentElement.removeAttribute('data-theme');
          try { localStorage.setItem('pilot-theme', 'dark'); } catch (e) {}
        } else {
          document.documentElement.setAttribute('data-theme', 'light');
          try { localStorage.setItem('pilot-theme', 'light'); } catch (e) {}
        }
      });
    }

    // Hamburger (mobile)
    var hamb = document.getElementById('nav-hamburger');
    var links = document.getElementById('nav-links');
    if (hamb && links) {
      hamb.addEventListener('click', function () {
        var open = links.classList.toggle('mobile-open');
        hamb.classList.toggle('is-open', open);
        hamb.setAttribute('aria-expanded', open ? 'true' : 'false');
        document.body.classList.toggle('nav-mobile-open', open);
      });
    }

    // Dropdown: click to toggle, click-outside to close
    document.querySelectorAll('.nav-dropdown').forEach(function (dd) {
      var trigger = dd.querySelector('.nav-dropdown-trigger');
      if (!trigger) return;
      trigger.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var isOpen = dd.classList.toggle('open');
        trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    });
    document.addEventListener('click', function (e) {
      document.querySelectorAll('.nav-dropdown.open').forEach(function (dd) {
        if (!dd.contains(e.target)) {
          dd.classList.remove('open');
          var trig = dd.querySelector('.nav-dropdown-trigger');
          if (trig) trig.setAttribute('aria-expanded', 'false');
        }
      });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        document.querySelectorAll('.nav-dropdown.open').forEach(function (dd) {
          dd.classList.remove('open');
          var trig = dd.querySelector('.nav-dropdown-trigger');
          if (trig) { trig.setAttribute('aria-expanded', 'false'); trig.focus(); }
        });
        if (links && links.classList.contains('mobile-open')) {
          links.classList.remove('mobile-open');
          if (hamb) { hamb.classList.remove('is-open'); hamb.setAttribute('aria-expanded', 'false'); }
          document.body.classList.remove('nav-mobile-open');
        }
      }
    });
  })();
</script>

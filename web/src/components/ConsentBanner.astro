---
// One-shot privacy banner. Choice persists in localStorage.
// "Allow"   -> analytics.ts lazy-loads PostHog (anon mode, recordings + heatmaps).
// "Decline" -> banner closes, no PostHog ever loaded for this device.
// GA4 (page views, custom events) runs regardless - no PII, no cross-site tracking.
---

<div id="consent-banner" class="consent-banner" role="dialog" aria-live="polite" aria-label="Privacy preferences" hidden>
  <p class="consent-text">
    We record anonymous session replays to see what works on the site.
    No PII, no cross-site tracking. Your call.
  </p>
  <div class="consent-actions">
    <button type="button" id="consent-accept" class="consent-btn">Allow</button>
    <button type="button" id="consent-decline" class="consent-btn ghost">Decline</button>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'pilot-analytics-consent';
    var banner = document.getElementById('consent-banner');
    if (!banner) return;
    if (!localStorage.getItem(KEY)) {
      banner.hidden = false;
    }
    var accept = document.getElementById('consent-accept');
    var decline = document.getElementById('consent-decline');
    accept && accept.addEventListener('click', function () {
      try { localStorage.setItem(KEY, 'accepted'); } catch (e) {}
      banner.hidden = true;
      if (typeof window.pilotInitPostHog === 'function') window.pilotInitPostHog();
    });
    decline && decline.addEventListener('click', function () {
      try { localStorage.setItem(KEY, 'declined'); } catch (e) {}
      banner.hidden = true;
    });
  })();
</script>

<style>
  .consent-banner {
    position: fixed;
    bottom: 16px;
    right: 16px;
    max-width: 340px;
    z-index: 9999;
    background: var(--bg-2);
    border: 1px solid var(--line);
    padding: 14px 16px;
    font-family: var(--sans);
    font-size: 13px;
    line-height: 1.45;
    color: var(--ink-dim);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  [data-theme="light"] .consent-banner {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
  }
  .consent-text { margin: 0; }
  .consent-actions { display: flex; gap: 8px; }
  .consent-btn {
    flex: 1;
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 7px 14px;
    background: var(--bg);
    color: var(--ink);
    border: 1px solid var(--line);
    cursor: pointer;
    transition: border-color 120ms;
  }
  .consent-btn:hover { border-color: var(--accent); color: var(--ink); }
  .consent-btn.ghost { background: transparent; color: var(--ink-dim); }
  @media (max-width: 480px) {
    .consent-banner {
      bottom: 8px;
      right: 8px;
      left: 8px;
      max-width: none;
    }
  }
</style>

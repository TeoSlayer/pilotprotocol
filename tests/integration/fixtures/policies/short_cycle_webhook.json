{
  "version": 1,
  "config": {"cycle": "1m"},
  "rules": [
    {
      "name": "allow-connect",
      "on": "connect",
      "match": "true",
      "actions": [{"type": "allow"}]
    },
    {
      "name": "allow-dial",
      "on": "dial",
      "match": "true",
      "actions": [{"type": "allow"}]
    },
    {
      "name": "allow-datagram",
      "on": "datagram",
      "match": "true",
      "actions": [{"type": "allow"}]
    },
    {
      "name": "cycle-webhook",
      "on": "cycle",
      "match": "true",
      "actions": [
        {"type": "webhook", "params": {"event": "cycle_fired", "data": {"source": "test"}}}
      ]
    }
  ]
}

{
  "version": 1,
  "rules": [
    {
      "name": "allow-connect",
      "on": "connect",
      "match": "true",
      "actions": [{"type": "allow"}]
    },
    {
      "name": "allow-dial",
      "on": "dial",
      "match": "true",
      "actions": [{"type": "allow"}]
    },
    {
      "name": "allow-datagram",
      "on": "datagram",
      "match": "true",
      "actions": [{"type": "allow"}]
    },
    {
      "name": "score-on-join",
      "on": "join",
      "match": "true",
      "actions": [{"type": "score", "params": {"delta": 10}}]
    }
  ]
}

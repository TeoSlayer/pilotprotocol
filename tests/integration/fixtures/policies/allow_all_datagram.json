{
  "version": 1,
  "rules": [
    {
      "name": "allow-connect",
      "on": "connect",
      "match": "true",
      "actions": [{"type": "allow"}]
    },
    {
      "name": "allow-dial",
      "on": "dial",
      "match": "true",
      "actions": [{"type": "allow"}]
    },
    {
      "name": "allow-all-datagram",
      "on": "datagram",
      "match": "true",
      "actions": [{"type": "allow"}]
    }
  ]
}

# =============================================================================
# Build artifacts
# =============================================================================
bin/
build/
*.exe
*.exe~
*.dll
*.so
*.dylib
*-linux
jetson

# Root-level Go build outputs
/daemon
/registry
/beacon
/rendezvous
/pilotctl
/nameserver
/gateway
/updater

# Go workspace
go.work
go.work.sum

# Go coverage / test artifacts
*.test
*.out
*.prof
coverage/
!coverage/badge.svg

# LaTeX build artifacts
*.aux
*.log
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# =============================================================================
# Dependency caches
# =============================================================================
# Python
__pycache__
.venv
venv

# Node / Astro
.astro/
node_modules/
web/node_modules/
web/dist/
web/.astro/
web/.wrangler/

# Root-level npm tooling (not the main module)
/package.json
/package-lock.json

# =============================================================================
# IDE / OS
# =============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# =============================================================================
# Runtime data & secrets
# =============================================================================
# Daemon sockets
*.sock
# Identity / private keys
*.key
# Databases
*.db
*.db-journal
*.db-wal
*.db-shm
pilot-graph.db.backup-*

# =============================================================================
# Temp / scratch
# =============================================================================
tmp/
.tmp
.tmp/
*.tmp
pilot-local.*

# =============================================================================
# Tests (ephemeral outputs + internal test-only tools)
# =============================================================================
tests/end-to-end/results
tests/integration/results
tests/integration/logs/
tests/integration/logs-run.out
tests/integration/k8s/preloaded/*.tar
tests/integration/local/logs/
tests/integration/local/results/
tests/admin_cli_test.go
cmd/spoof/

# =============================================================================
# Docs (allowlist — only track .tex, .pdf, SPEC.md, media/, ietf/, research/)
# =============================================================================
docs/*
!docs/*.tex
!docs/*.pdf
!docs/SPEC.md
!docs/media/
!docs/research/
!docs/ietf/

# =============================================================================
# Private / internal (not open-source)
# =============================================================================
.claude
AGENTS.md
.mcp.json
cmd/pilot-admin/
cmd/console/
console
console-ui/
pkg/console/
newsletter/
web/MESSAGING.md
scripts/publish-worker/src/webhook.ts
scripts/publish-worker/test/webhook.test.ts

# =============================================================================
# Web: stale Astro outputs (regenerated at build time)
# =============================================================================
web/blog/*.html
web/blog/style.css
web/docs/*.html
web/docs/style.css

# =============================================================================
# Web: duplicate assets (source of truth: web/public/)
# =============================================================================
web/blog/banners/
web/img/
web/research/

# =============================================================================
# Ephemeral one-off research / survey outputs
# =============================================================================
survey*.mjs
*-results.jsonl
*-dashboard.html
